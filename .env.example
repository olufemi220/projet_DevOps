# ═══════════════════════════════════════════════════════
# Student Management Microservices - Environment Configuration
# ═══════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────
# Database Configuration
# ──────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_secure_password_2025
MYSQL_USER=student_user
MYSQL_PASSWORD=student_password
MYSQL_DATABASE=StudentManagement_Dev
DATABASE_HOST=mysql
DATABASE_PORT=3306

# ──────────────────────────────────────────────────────
# C# Backend Configuration
# ──────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
ConnectionStrings__DefaultConnection="Server=mysql;Database=StudentManagement_Dev;User Id=root;Password=root_secure_password_2025;Port=3306;Allow User Variables=true;"
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:3020

# ──────────────────────────────────────────────────────
# Java Backend Configuration
# ──────────────────────────────────────────────────────
JAVA_DATASOURCE_URL=jdbc:mysql://mysql:3306/StudentManagement_Dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
JAVA_DATASOURCE_USERNAME=root
JAVA_DATASOURCE_PASSWORD=root_secure_password_2025
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop
SPRING_JPA_SHOW_SQL=false
SPRING_PROFILES_ACTIVE=dev

# ──────────────────────────────────────────────────────
# Node.js Backend Configuration
# ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=mysql://root:root_secure_password_2025@mysql:3306/StudentManagement_Dev
CORS_ORIGIN=http://localhost:3000,http://localhost:3010,http://localhost:3020

# ──────────────────────────────────────────────────────
# Frontend Configuration
# ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NODE_ENV=development

# ──────────────────────────────────────────────────────
# API Backend URLs (for service-to-service communication)
# ──────────────────────────────────────────────────────
# Development
CSHARP_API_INTERNAL_DEV=http://backend-csharp-dev:5000
JAVA_API_INTERNAL_DEV=http://backend-java-dev:8080
NODE_API_INTERNAL_DEV=http://backend-node-dev:4000

# Staging/UAT
CSHARP_API_INTERNAL_UAT=http://backend-csharp-uat:5000
JAVA_API_INTERNAL_UAT=http://backend-java-uat:8080
NODE_API_INTERNAL_UAT=http://backend-node-uat:4000

# Production
CSHARP_API_INTERNAL_PRD=http://backend-csharp:5000
JAVA_API_INTERNAL_PRD=http://backend-java:8080
NODE_API_INTERNAL_PRD=http://backend-node:4000

# ──────────────────────────────────────────────────────
# Kubernetes Configuration (if running on K8s)
# ──────────────────────────────────────────────────────
K8S_NAMESPACE=student-management
K8S_ENVIRONMENT=development

# ──────────────────────────────────────────────────────
# GitLab CI/CD Configuration
# ──────────────────────────────────────────────────────
CI_REGISTRY_IMAGE=registry.gitlab.com/your-group/projet_devops
IMAGE_FRONTEND=registry.gitlab.com/your-group/projet_devops/frontend
IMAGE_CSHARP=registry.gitlab.com/your-group/projet_devops/backend-csharp
IMAGE_JAVA=registry.gitlab.com/your-group/projet_devops/backend-java
IMAGE_NODE=registry.gitlab.com/your-group/projet_devops/backend-node

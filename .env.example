# Environment Configuration Example
# Copy this file to .env and update values for your environment

# Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=StudentManagement_Dev
MYSQL_USER=student_user
MYSQL_PASSWORD=student_password123

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000

# C# Backend Configuration
ASPNETCORE_ENVIRONMENT=Development
ConnectionString=Server=mysql;Port=3306;Database=StudentManagement_Dev;Uid=student_user;Pwd=student_password123;

# Java Backend Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/StudentManagement_Dev
SPRING_DATASOURCE_USERNAME=student_user
SPRING_DATASOURCE_PASSWORD=student_password123
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Node.js Backend Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=student_user
DB_PASSWORD=student_password123
DB_NAME=StudentManagement_Dev
NODE_ENV=development

# API Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Docker Configuration
COMPOSE_PROJECT_NAME=student-management

# Kubernetes Configuration (for prod)
K8S_NAMESPACE=student-management
K8S_ENVIRONMENT=production
